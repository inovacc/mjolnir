# ============================================
# Stage 1: Builder - compile lightweight Go tools only
# ============================================
FROM golang:1.27.0 AS builder

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}

# Pinned Go tool versions (bump via Dependabot/Renovate)
ARG PROTOC_GEN_GO_VERSION=v1.36.11
ARG PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
ARG MOCKGEN_VERSION=v0.6.0
ARG XC_VERSION=v0.9.0
ARG GOVULNCHECK_VERSION=v1.6.0
ARG STATICCHECK_VERSION=2025.1.1
ARG GOTESTSUM_VERSION=v1.13.0

# Install only lightweight Go tools (no pre-built binaries available)
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION} \
 && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION} \
 && go install go.uber.org/mock/mockgen@${MOCKGEN_VERSION} \
 && go install github.com/joerdav/xc/cmd/xc@${XC_VERSION} \
 && go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION} \
 && go install honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION} \
 && go install gotest.tools/gotestsum@${GOTESTSUM_VERSION}

# ============================================
# Stage 2: Final - download pre-built + runtime
# ============================================
FROM golang:1.27.0

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}

WORKDIR /workspace

# Pinned tool versions (bump via Dependabot/Renovate)
ARG GORELEASER_VERSION=2.17.0
ARG GOLANGCI_LINT_VERSION=2.12.2
ARG SYFT_VERSION=1.46.0
ARG COSIGN_VERSION=3.1.1
ARG GITLEAKS_VERSION=8.30.1
ARG SQLC_VERSION=1.31.1
ARG TASK_VERSION=3.52.0
ARG BUF_VERSION=1.71.0
ARG HADOLINT_VERSION=2.14.0
ARG YQ_VERSION=4.53.3
ARG BUN_VERSION=1.3.14
ARG PNPM_VERSION=11.10.0
ARG TYPESCRIPT_VERSION=5.9.3
ARG RUSTUP_VERSION=1.29.0
ARG RUST_VERSION=1.97.0
ARG CARGO_NEXTEST_VERSION=0.9.137
ARG CARGO_DENY_VERSION=0.18.7
ARG CARGO_CHEF_VERSION=0.1.74
ARG CARGO_AUDIT_VERSION=0.22.0
ARG CARGO_LLVM_COV_VERSION=0.6.19
ARG DOCKER_VERSION=27.5.1

# Install runtime dependencies
# hadolint ignore=DL3008,DL4006
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates bash make curl unzip jq mold \
    nodejs npm python3 python3-pip gcc \
 && rm -rf /var/lib/apt/lists/* \
 && rm -rf /var/cache/apt/*

# Install all prebuilt tools via the shared installer (H-06). Both images run
# the same script; only the libc argument differs (gnu here, musl on Alpine).
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
COPY scripts/install-tools.sh /tmp/install-tools.sh
RUN bash /tmp/install-tools.sh gnu && rm -f /tmp/install-tools.sh

ENV RUSTUP_HOME=/usr/local/rustup

# Copy compiled tools from builder
COPY --from=builder /go/bin/* /go/bin/

# Copy tools table generator script
COPY scripts/generate-tools-table.sh /usr/local/bin/generate-tools-table.sh
RUN chmod +x /usr/local/bin/generate-tools-table.sh

# Generate build metadata
ARG BUILD_VERSION=dev
# hadolint ignore=SC3028,SC3054
RUN mkdir -p /etc/mjolnir && \
    FIGURES=(thor odin freya loki heimdall zeus athena apollo mars venus ra anubis phoenix griffin) && \
    REALMS=(asgard valhalla olympus thunder storm forge fire wisdom valor eternal divine) && \
    FIGURE=${FIGURES[$RANDOM % ${#FIGURES[@]}]} && \
    REALM=${REALMS[$RANDOM % ${#REALMS[@]}]} && \
    GO_VER=$(go version | awk '{print $3}' | sed 's/go//') && \
    echo "${GO_VER}D-${FIGURE}-${REALM}" > /etc/mjolnir/BUILD_TAG && \
    echo "${GO_VER}" > /etc/mjolnir/GO_VERSION && \
    echo "${FIGURE}-${REALM}" > /etc/mjolnir/BUILD_NAME && \
    echo "${BUILD_VERSION}" > /etc/mjolnir/BUILD_VERSION && \
    /usr/local/bin/generate-tools-table.sh /etc/mjolnir/TOOLS_TABLE

ENV CARGO_HOME=/usr/local/cargo \
    HOME=/home/builder \
    PATH="/go/bin:/usr/local/cargo/bin:${PATH}" \
    UMASK=027

# The image is a build worker, not a privileged shell. Keep the toolchain and
# cache locations writable by the job user while dropping root before GHA steps.
RUN useradd --create-home --shell /bin/bash builder && \
    mkdir -p /usr/local/cargo /home/builder/.cache /workspace && \
    chown -R builder:builder /usr/local/cargo /home/builder /workspace /go

USER builder

# Labels with build metadata
LABEL org.opencontainers.image.title="mjolnir" \
      org.opencontainers.image.description="The hammer for every build - Multi-language CI container (Debian)" \
      org.opencontainers.image.source="https://github.com/inovacc/mjolnir" \
      org.opencontainers.image.vendor="inovacc"

# Display tools table
CMD ["cat", "/etc/mjolnir/TOOLS_TABLE"]
